# Copy to .env and fill in values. Never commit .env.
# Names only here — no real secrets.

NODE_ENV=development
API_PORT=3000

# PostgreSQL (docker compose provides this locally)
DATABASE_URL=postgres://vta:vta_dev@localhost:5432/vta
TEST_DATABASE_URL=postgres://vta:vta_dev@localhost:5432/vta_test

# Public URL of the web app, used to build invitation links
APP_ORIGIN=http://localhost:5173

# Delivery providers. "console" prints codes and links to the API log.
# The console providers refuse to start when NODE_ENV=production.
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Set to true only behind HTTPS (staging/production)
COOKIE_SECURE=false

# Uploaded files. Only the local driver exists until hosting is chosen.
STORAGE_DRIVER=local
STORAGE_DIR=.storage
# Signs 5-minute download links. Required in production (32+ random characters).
# Leave empty in development: a random secret is made at each start.
FILE_SIGNING_SECRET=

# Printed as the issuer on course completion credentials and the public verify page (decision D8).
CREDENTIAL_ISSUER_NAME=AutoTalent Grid
